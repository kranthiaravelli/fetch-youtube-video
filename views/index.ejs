<!DOCTYPE html>
<html lang="en">
<head>

    <%- include("../includes/head.ejs") %>

</head>
<body>

    <div class="main-container">
        <h1>Fetch YouTube Video Using URL</h1>
        <p>Enter YouTube URL to get started.</p>

        <form id="video-form">
            <input 
                type="url" 
                name="videoURL" 
                id="video-url"
                placeholder="Paste a YouTube URL"
                required
            >

            <button type="submit">Get Video Info</button>
        </form>

        <p id="message" role="status"></p>       
        
        <section id="video-result"></section>
    </div>
    
    <script src="/script.js"></script>
</body>
</html>